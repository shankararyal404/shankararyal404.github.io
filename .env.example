# Turso Database Configuration
TURSO_DATABASE_URL=libsql://your-db-name-user.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Optional Infra DB (defaults to main if not set)
# TURSO_INFRA_DATABASE_URL=
# TURSO_INFRA_AUTH_TOKEN=

# Security
JWT_SECRET=generate-a-long-random-string-here

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email Addresses
EMAIL_ADMIN=admin@example.com
EMAIL_CONTACT=contact@example.com
EMAIL_NOTIFICATION=notifications@example.com
EMAIL_NO_REPLY=no-reply@example.com
EMAIL_SECURITY=security@example.com
EMAIL_INFO=info@example.com

# OAuth (Existing Vercel Secrets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRETS=
GITHUB_Client_ID=
GITHUB_CLIENT_SECRET=

# Twitter/X (Optional)
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=

